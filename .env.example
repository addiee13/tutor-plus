NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial bootstrap only; never NEXT_PUBLIC, never used by the web application.
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_USER_ID=

# Disposable test identities with confirmed email and Student/Tutor roles.
# Never put passwords in shell arguments. Integration tests skip without these.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
SUPABASE_OTHER_TEST_EMAIL=
SUPABASE_OTHER_TEST_PASSWORD=
SUPABASE_UNVERIFIED_TEST_EMAIL=
SUPABASE_UNVERIFIED_TEST_PASSWORD=
SUPABASE_TEST_ALLOW_MUTATIONS=false
SUPABASE_TEST_SESSION_DB_MUTATIONS=false
SUPABASE_ADMIN_TEST_EMAIL=
SUPABASE_ADMIN_TEST_PASSWORD=
SUPABASE_TEST_USER_ID=
PLAYWRIGHT_CHANNEL=

# Local Google/GitHub sign-in (read by the Supabase CLI from .env.local). Keep *_ENABLED=false until the OAuth
# app for http://127.0.0.1:54321/auth/v1/callback exists and its client ID and secret are filled in.
SUPABASE_AUTH_EXTERNAL_GITHUB_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
